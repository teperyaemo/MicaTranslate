<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MicaTranslate.UI.Controls.HotkeyPickerDialogContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MicaTranslate.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:selectors="using:MicaTranslate.UI.Selectors" xmlns:converters="using:MicaTranslate.UI.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:VirtualKeyToNameConverter x:Key="KeyNameConverter"/>

        <DataTemplate x:Key="KeyTemplate">
            <Border
                Padding="16"
                Height="56"
                MinWidth="56"
                CornerRadius="2"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
                <TextBlock
                Text="{Binding Converter={StaticResource KeyNameConverter}}"
                FontSize="17"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WinKeyTemplate">
            <Border
                Padding="16"
                Height="56"
                MinWidth="56"
                CornerRadius="2"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
                <Grid>
                    <Viewbox
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <PathIcon
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Data="M9 20H0V11H9V20ZM20 20H11V11H20V20ZM9 9H0V0H9V9ZM20 9H11V0H20V9Z"/>
                    </Viewbox>
                </Grid>
            </Border>
        </DataTemplate>

        <selectors:HotkeyTemplateSelector
        x:Key="HotkeyTemplateSelector"
        KeyTemplate="{StaticResource KeyTemplate}"
        WinKeyTemplate="{StaticResource WinKeyTemplate}"/>

    </UserControl.Resources>
    
    <StackPanel
        Name="RootPanel"
        MinWidth="540"
        Orientation="Vertical"
        Spacing="16"
        IsTabStop="True"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp">

        <TextBlock
            Text="Нажмите комбинацию клавиш, чтобы изменить его"
            TextWrapping="Wrap" />

        <ItemsControl
            ItemsSource="{x:Bind PressedKeys}"
            ItemTemplateSelector="{StaticResource HotkeyTemplateSelector}"
            x:Name="HotkeyItems"
            Height="56"
            Margin="0,24,0,24"
            HorizontalAlignment="Center">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

        </ItemsControl>

        <InfoBar
            Margin="0,0,42,0"
            x:Name="ConflictInfoBar"
            IsOpen="False"
            Severity="Warning"
            IsClosable="False"
            Title="Горячая клавиша недоступна"
            Message="Комбинация уже используется системой или другим приложением.">
        </InfoBar>

    </StackPanel>
</UserControl>
