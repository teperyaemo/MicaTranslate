<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MicaTranslate.UI.Controls.HotkeyPickerDialogContentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MicaTranslate.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MicaTranslate.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:selectors="using:MicaTranslate.UI.Selectors"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:VirtualKeyToNameConverter x:Key="KeyNameConverter" />

        <DataTemplate x:Key="KeyTemplate">
            <Border
                Height="56"
                MinWidth="56"
                Padding="16"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="2">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Text="{Binding Converter={StaticResource KeyNameConverter}}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WinKeyTemplate">
            <Border
                Height="56"
                MinWidth="56"
                Padding="16"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="2">
                <Grid>
                    <Viewbox
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <PathIcon Data="M9 20H0V11H9V20ZM20 20H11V11H20V20ZM9 9H0V0H9V9ZM20 9H11V0H20V9Z" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Viewbox>
                </Grid>
            </Border>
        </DataTemplate>

        <selectors:HotkeyTemplateSelector
            x:Key="HotkeyTemplateSelector"
            KeyTemplate="{StaticResource KeyTemplate}"
            WinKeyTemplate="{StaticResource WinKeyTemplate}" />

    </UserControl.Resources>

    <StackPanel
        Name="RootPanel"
        MinWidth="540"
        IsTabStop="True"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp"
        Orientation="Vertical"
        Spacing="16">

        <TextBlock Text="Нажмите комбинацию клавиш, чтобы изменить его" TextWrapping="Wrap" />

        <ItemsControl
            x:Name="HotkeyItems"
            Height="56"
            Margin="0,24,0,24"
            HorizontalAlignment="Center"
            ItemTemplateSelector="{StaticResource HotkeyTemplateSelector}"
            ItemsSource="{x:Bind PressedKeys}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

        </ItemsControl>

        <InfoBar
            x:Name="ConflictInfoBar"
            Title="Горячая клавиша недоступна"
            Margin="0,0,42,0"
            IsClosable="False"
            IsOpen="False"
            Message="Комбинация уже используется системой или другим приложением."
            Severity="Warning" />

    </StackPanel>
</UserControl>
