<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MicaTranslate.UI.Controls.HotkeyPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MicaTranslate.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls" 
    xmlns:selectors="using:MicaTranslate.UI.Selectors" 
    xmlns:converters="using:MicaTranslate.UI.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:VirtualKeyToNameConverter x:Key="KeyNameConverter"/>

        <DataTemplate x:Key="KeyTemplate">
            <Border
            Padding="12,0"
            Height="36"
            MinWidth="36"
            CornerRadius="2"
            Background="{ThemeResource AccentFillColorDefaultBrush}">
                <TextBlock
                    Text="{Binding Converter={StaticResource KeyNameConverter}}"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WinKeyTemplate">
            <Border
            Padding="12,0"
            Height="36"
            MinWidth="36"
            CornerRadius="2"
            Background="{ThemeResource AccentFillColorDefaultBrush}">
                <Viewbox
                    Width="10"
                    Height="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <PathIcon
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Data="M9 20H0V11H9V20ZM20 20H11V11H20V20ZM9 9H0V0H9V9ZM20 9H11V0H20V9Z"/>
                </Viewbox>
            </Border>
        </DataTemplate>

        <selectors:HotkeyTemplateSelector
        x:Key="HotkeyTemplateSelector"
        KeyTemplate="{StaticResource KeyTemplate}"
        WinKeyTemplate="{StaticResource WinKeyTemplate}"/>

    </UserControl.Resources>

    <Grid>
        <controls:SettingsCard
            Header="{x:Bind Header}"
            Description="{x:Bind Description}"
            HeaderIcon="{x:Bind HeaderIcon}">
            <Button Click="OpenDialog"
                    Padding="12"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <ItemsControl
                        ItemsSource="{x:Bind PressedKeys}"
                        ItemTemplateSelector="{StaticResource HotkeyTemplateSelector}"
                        x:Name="HotkeyItems"
                        HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid>
                        <FontIcon Glyph="&#xE70F;" FontSize="16"/>
                    </Grid>
                </StackPanel>
            </Button>
        </controls:SettingsCard>

    </Grid>
    
</UserControl>
