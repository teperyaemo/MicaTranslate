<Page
    x:Class="MicaTranslate.UI.Pages.CryptoSupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Height="45"
            Padding="6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="8,8,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="4">

                <Button
                    Command="{x:Bind _viewModel.GoBackCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="6,2">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="5">

                        <FontIcon
                            Glyph="&#xE72B;"
                            FontSize="13"/>

                        <TextBlock
                            x:Uid="CryptoSupportPage_GoBackBtn"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <TextBlock
                    x:Uid="CryptoSupportPage_TitleTb"
                    Margin="4,0,0,0"
                    FontSize="16"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center"/>

            </StackPanel>

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">

                <ToggleButton
                    x:Uid="CryptoSupportPage_PinBtn"
                    Content="📌"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="16"
                    IsChecked="{x:Bind _viewModel.AlwaysOnTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>

        </Grid>

        <Grid
            Grid.Row="1"
            Padding="12"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="200"
                Height="200"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8"
                Padding="8">

                <Image
                    Source="ms-appx:///Assets/Crypto/UsdtTronQr.svg"
                    Stretch="Uniform"/>

            </Border>

            <Grid
                Grid.Column="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Spacing="3">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">

                        <TextBlock
                            Text="USDT"
                            FontSize="22"
                            Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <Border
                            Padding="7,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4">

                            <TextBlock
                                Text="TRON"
                                FontSize="11"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>

                        </Border>

                    </StackPanel>

                    <TextBlock
                        x:Uid="CryptoSupportPage_NetworkTb"
                        FontSize="12"
                        Opacity="0.65"/>

                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    Spacing="5">

                    <TextBlock
                        x:Uid="CryptoSupportPage_WalletAddressTb"
                        FontSize="12"
                        Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            MinHeight="34"
                            Padding="9,6"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">

                            <TextBlock
                                x:Name="WalletAddressTextBlock"
                                Text="{x:Bind _viewModel.CryptoWalletAddress, Mode=OneWay}"
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"/>

                        </Border>

                        <Button
                            x:Name="CopyWalletButton"
                            x:Uid="CryptoSupportPage_CopyWalletBtn"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Click="CopyWalletButton_Click"
                            VerticalAlignment="Center"/>

                    </Grid>

                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    x:Uid="CryptoSupportPage_ScanQrTb"
                    Margin="0,5,0,0"
                    FontSize="11"
                    Opacity="0.6"/>

                <InfoBar
                    Grid.Row="3"
                    x:Uid="CryptoSupportPage_InfoBar"
                    Margin="0,12,0,0"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Warning"/>

            </Grid>

        </Grid>

    </Grid>

</Page>