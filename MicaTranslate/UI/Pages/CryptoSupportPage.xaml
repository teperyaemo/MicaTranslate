<Page
    x:Class="MicaTranslate.UI.Pages.CryptoSupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Height="45"
            Padding="6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="8,8,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="4">

                <Button
                    Padding="6,2"
                    Command="{x:Bind _viewModel.GoBackCommand}"
                    Style="{StaticResource SubtleButtonStyle}">

                    <StackPanel Orientation="Horizontal" Spacing="5">

                        <FontIcon FontSize="13" Glyph="&#xE72B;" />

                        <TextBlock x:Uid="CryptoSupportPage_GoBackBtn" VerticalAlignment="Center" />

                    </StackPanel>

                </Button>

                <TextBlock
                    x:Uid="CryptoSupportPage_TitleTb"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

            </StackPanel>

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">

                <ToggleButton
                    x:Uid="CryptoSupportPage_PinBtn"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="📌"
                    FontSize="16"
                    IsChecked="{x:Bind _viewModel.AlwaysOnTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>

        </Grid>

        <Grid
            Grid.Row="1"
            Padding="12"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="200"
                Height="200"
                Padding="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="8">

                <Image Source="ms-appx:///Assets/Crypto/UsdtTronQr.svg" Stretch="Uniform" />

            </Border>

            <Grid
                Grid.Column="2"
                Margin="0,0,8,0"
                VerticalAlignment="Center">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="3">

                    <StackPanel Orientation="Horizontal" Spacing="8">

                        <TextBlock
                            FontSize="22"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="USDT" />

                        <Border
                            Padding="7,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4">

                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="TRON" />

                        </Border>

                    </StackPanel>

                    <TextBlock
                        x:Uid="CryptoSupportPage_NetworkTb"
                        FontSize="12"
                        Opacity="0.65" />

                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    Spacing="5">

                    <TextBlock
                        x:Uid="CryptoSupportPage_WalletAddressTb"
                        FontSize="12"
                        Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            MinHeight="34"
                            Padding="9,6"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">

                            <TextBlock
                                x:Name="WalletAddressTextBlock"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind _viewModel.CryptoWalletAddress, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />

                        </Border>

                        <Button
                            x:Name="CopyWalletButton"
                            x:Uid="CryptoSupportPage_CopyWalletBtn"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Click="CopyWalletButton_Click" />

                    </Grid>

                </StackPanel>

                <TextBlock
                    x:Uid="CryptoSupportPage_ScanQrTb"
                    Grid.Row="2"
                    Margin="0,5,0,0"
                    FontSize="11"
                    Opacity="0.6" />

                <InfoBar
                    x:Uid="CryptoSupportPage_InfoBar"
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Warning" />

            </Grid>

        </Grid>

    </Grid>

</Page>