<Page
    x:Class="MicaTranslate.UI.Pages.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <Grid
            Grid.Row="0"
            Height="45"
            Padding="6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="8,8,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="4">

                <Button
                    Padding="6,2"
                    Command="{x:Bind _viewModel.GoBackCommand}"
                    Style="{StaticResource SubtleButtonStyle}">

                    <StackPanel Orientation="Horizontal" Spacing="5">

                        <FontIcon FontSize="13" Glyph="&#xE72B;" />

                        <TextBlock x:Uid="SupportPage_GoBackBtn" VerticalAlignment="Center" />

                    </StackPanel>

                </Button>

                <TextBlock
                    x:Uid="SupportPage_TitleTb"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

            </StackPanel>


            <Grid Grid.Column="2">

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">

                    <ToggleButton
                        x:Uid="SupportPage_PinBtn"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="📌"
                        FontSize="16"
                        IsChecked="{x:Bind _viewModel.AlwaysOnTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>

            </Grid>

        </Grid>


        <Grid
            Grid.Row="1"
            Padding="6"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">

            <StackPanel Spacing="6">

                <ctcontrols:SettingsCard
                    x:Name="GithubSettingsCard"
                    x:Uid="SupportPage_GithubSc"
                    Click="GithubSettingsCard_Click"
                    IsClickEnabled="True">

                    <ctcontrols:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Github-logo.png" />
                    </ctcontrols:SettingsCard.HeaderIcon>

                </ctcontrols:SettingsCard>


                <ctcontrols:SettingsCard
                    x:Name="BoostySettingsCard"
                    x:Uid="SupportPage_BoostySc"
                    Click="BoostySettingsCard_Click"
                    IsClickEnabled="True">

                    <ctcontrols:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Boosty-logo.png" />
                    </ctcontrols:SettingsCard.HeaderIcon>

                </ctcontrols:SettingsCard>


                <ctcontrols:SettingsCard
                    x:Name="CloudpaymentsSettingsCard"
                    x:Uid="SupportPage_CloudpaymentsSc"
                    Click="CloudpaymentsSettingsCard_Click"
                    IsClickEnabled="True">

                    <ctcontrols:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Cloudpayments-logo.png" />
                    </ctcontrols:SettingsCard.HeaderIcon>

                </ctcontrols:SettingsCard>


                <ctcontrols:SettingsCard
                    x:Name="CryptoSettingsCard"
                    x:Uid="SupportPage_CryptoSc"
                    Command="{x:Bind _viewModel.OpenCryptoSupportCommand}"
                    IsClickEnabled="True">

                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </ctcontrols:SettingsCard.HeaderIcon>

                </ctcontrols:SettingsCard>

            </StackPanel>

        </Grid>

    </Grid>

</Page>