<Page
    x:Class="MicaTranslate.UI.Pages.SupportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Grid
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            CornerRadius="8,8,0,0"
            Height="45"
            Padding="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="4">

                <Button
                    Command="{x:Bind _viewModel.GoBackCommand}"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="6,2">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="5">

                        <FontIcon
                            Glyph="&#xE72B;"
                            FontSize="13"/>

                        <TextBlock
                            x:Uid="SupportPage_GoBackBtn"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>
                
                <TextBlock
                    Grid.Column="0"
                    x:Uid="SupportPage_TitleTb"
                    FontSize="16"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center"/>

            </StackPanel>


            <Grid
                Grid.Column="2">

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">

                    <ToggleButton
                        Content="📌"
                        x:Uid="SupportPage_PinBtn"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{x:Bind _viewModel.AlwaysOnTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="16"/>
                    
                </StackPanel>

            </Grid>

        </Grid>


        <Grid
            Grid.Row="1"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="6">

            <StackPanel Spacing="6">

                <ctcontrols:SettingsCard
                    x:Name="GithubSettingsCard"
                    IsClickEnabled="True"
                    Click="GithubSettingsCard_Click"
                    x:Uid="SupportPage_GithubSc">

                    <ctcontrols:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Github-logo.png"/>
                    </ctcontrols:SettingsCard.HeaderIcon>

                </ctcontrols:SettingsCard>


                <ctcontrols:SettingsCard
                    x:Name="BoostySettingsCard"
                    x:Uid="SupportPage_BoostySc"
                    Click="BoostySettingsCard_Click"
                    IsClickEnabled="True">

                    <ctcontrols:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Boosty-logo.png"/>
                    </ctcontrols:SettingsCard.HeaderIcon>

                </ctcontrols:SettingsCard>


                <ctcontrols:SettingsCard
                    x:Name="CloudpaymentsSettingsCard"
                    x:Uid="SupportPage_CloudpaymentsSc"
                    Click="CloudpaymentsSettingsCard_Click"
                    IsClickEnabled="True">

                    <ctcontrols:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/Cloudpayments-logo.png"/>
                    </ctcontrols:SettingsCard.HeaderIcon>

                </ctcontrols:SettingsCard>


                <ctcontrols:SettingsCard
                    x:Name="CryptoSettingsCard"
                    x:Uid="SupportPage_CryptoSc"
                    IsClickEnabled="True"
                    Command="{x:Bind _viewModel.OpenCryptoSupportCommand}">

                    <ctcontrols:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;"/>
                    </ctcontrols:SettingsCard.HeaderIcon>

                </ctcontrols:SettingsCard>

            </StackPanel>

        </Grid>

    </Grid>

</Page>